/* !
 * \file bessel_i0.asc
 * \brief 本用例用于验证BesselI0高阶API用例框架的可用性。由于BesselI0高阶API尚在开发中，
 *           本用例暂用Erf高阶API替代进行功能与性能验证，待BesselI0 API上线后替换即可。
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

struct BesselI0CustomTilingData {
    uint32_t totalLength;
};

void GenerateTilingData(uint8_t* tilingBuf, const uint32_t totalLength, const uint32_t coreNum)
{
    BesselI0CustomTilingData* tiling = reinterpret_cast<BesselI0CustomTilingData*>(tilingBuf);

    tiling->totalLength = totalLength;
}

namespace MyCustomKernel {

/**
 * @brief BesselI0核函数实现类，演示BesselI0 API的使用场景
 * @tparam T 数据类型
 */
template <typename T>
class KernelBesselI0 {
public:
    __aicore__ inline KernelBesselI0() {}
    __aicore__ inline void Init(
        __gm__ uint8_t* x, __gm__ uint8_t* y, BesselI0CustomTilingData tilingData, AscendC::TPipe* pipeIn)
    {
        ASCENDC_ASSERT(AscendC::GetBlockNum() != 0, { KERNEL_LOG(KERNEL_ERROR, "block dim can not be zero!"); });
        this->blockLength = tilingData.totalLength;

        // UB Buffer 要求 32B 对齐：计算对齐后的元素个数，用于 InitBuffer 分配与 DataCopy 搬运
        constexpr uint32_t oneBlkSize = 32 / sizeof(T);
        this->alignLength = (this->blockLength + oneBlkSize - 1) / oneBlkSize * oneBlkSize;

        xGm.SetGlobalBuffer((__gm__ T*)x, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ T*)y, this->blockLength);

        pipe = pipeIn;
        pipe->InitBuffer(inQueueX, 1, this->alignLength * sizeof(T));
        pipe->InitBuffer(outQueueY, 1, this->alignLength * sizeof(T));
    }

    __aicore__ inline void ProcessPrecision()
    {
        CopyIn();
        ComputeOnce();
        CopyOut();
    }

    __aicore__ inline void ProcessCopyOnly()
    {
        CopyIn();
        CopyOutInput();
    }

    __aicore__ inline void ProcessComputeLoop()
    {
        CopyIn();
        ComputeLoop();
        CopyOut();
    }

private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::DataCopyPadParams dataCopyPadParams;
        AscendC::DataCopyPad(
            xLocal, xGm, {1, static_cast<uint16_t>(this->blockLength * sizeof(T)), 0, 0}, dataCopyPadParams);
        inQueueX.EnQue(xLocal);
    }
    __aicore__ inline void ComputeOnce()
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = outQueueY.AllocTensor<T>();
        // 暂用Erf高阶API替代BesselI0进行验证，待BesselI0 API上线后替换为：
        //   AscendC::BesselI0<T, false>(yLocal, xLocal, this->blockLength);
        AscendC::Erf<T, false>(yLocal, xLocal, this->blockLength);
        outQueueY.EnQue<T>(yLocal);
        inQueueX.FreeTensor(xLocal);
    }
    __aicore__ inline void ComputeLoop()
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = outQueueY.AllocTensor<T>();
        for (int32_t j = 0; j < 1000; j++) {
            AscendC::Erf<T, false>(yLocal, xLocal, this->blockLength);
        }
        outQueueY.EnQue<T>(yLocal);
        inQueueX.FreeTensor(xLocal);
    }
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<T> yLocal = outQueueY.DeQue<T>();
        AscendC::DataCopyPad(yGm, yLocal, {1, static_cast<uint16_t>(this->blockLength * sizeof(T)), 0, 0});
        outQueueY.FreeTensor(yLocal);
    }
    __aicore__ inline void CopyOutInput()
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::DataCopyPad(yGm, xLocal, {1, static_cast<uint16_t>(this->blockLength * sizeof(T)), 0, 0});
        inQueueX.FreeTensor(xLocal);
    }

private:
    AscendC::TPipe* pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueY;
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;

    uint32_t blockLength = 0;
    uint32_t alignLength = 0;
};
} // namespace MyCustomKernel

__vector__ __global__ void bessel_i0_custom(
    __gm__ uint8_t* x, __gm__ uint8_t* y, BesselI0CustomTilingData tiling)
{
    if ASCEND_IS_AIC {
        return;
    }
    AscendC::TPipe pipe;
    MyCustomKernel::KernelBesselI0<float> op;
    op.Init(x, y, tiling, &pipe);
#if TEST_MODE == 1
    op.ProcessPrecision();
#elif TEST_MODE == 2
    op.ProcessCopyOnly();
#elif TEST_MODE == 3
    op.ProcessComputeLoop();
#else
    #error "TEST_MODE must be 1, 2, or 3"
#endif
}

namespace {
constexpr uint32_t USED_CORE_NUM = 1;
constexpr uint32_t TOTAL_LENGTH = SIZE;
} // namespace

static bool CompareResult(const void* outputData, uint32_t outSize)
{
    void* goldenData;
    aclrtMallocHost((void**)(&goldenData), outSize);
    size_t goldenSize = outSize;
    bool ret = ReadFile("./output/golden.bin", goldenSize, goldenData, goldenSize);
    if (ret) {
        printf("ReadFile golden.bin success!\n");
    } else {
        printf("test failed!\n");
        return false;
    }
    constexpr float EPS = 1e-4;
    constexpr float ERR_RATIO = 1e-4;
    int64_t wrongNum = 0;
    int64_t totalNum = outSize / sizeof(float);

    for (size_t i = 0; i < totalNum; i++) {
        float a = (reinterpret_cast<const float*>(outputData))[i];
        float b = (reinterpret_cast<const float*>(goldenData))[i];
        float re = std::abs(a - b) / std::abs(b);
        if (re > EPS) {
            printf("CompareResult golden.bin failed output is %lf, golden is %lf\n", a, b);
            wrongNum++;
        }
    }
    aclrtFreeHost(goldenData);
    float wrongRatio = (totalNum > 0) ? static_cast<float>(wrongNum) / totalNum : 0.0f;
    printf("error ratio: %.4f, tolerance: %.4f\n", wrongRatio, ERR_RATIO);
    if (wrongRatio > ERR_RATIO) {
        return false;
    }
    printf("CompareResult golden.bin success!\n");
    return true;
}

int32_t main(int32_t argc, char* argv[])
{
    size_t inputSize = TOTAL_LENGTH * sizeof(uint32_t);
    size_t outputSize = inputSize;
    BesselI0CustomTilingData tiling = {TOTAL_LENGTH};

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *yHost;
    uint8_t *xDevice, *yDevice;

    aclrtMallocHost((void**)(&xHost), inputSize);
    aclrtMallocHost((void**)(&yHost), outputSize);

    aclrtMalloc((void**)&xDevice, inputSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, outputSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", inputSize, xHost, inputSize);

    // Copy host memory to device memory
    aclrtMemcpy(xDevice, inputSize, xHost, inputSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // Execute the kernel
    bessel_i0_custom<<<USED_CORE_NUM, nullptr, stream>>>(xDevice, yDevice, tiling);

    // Wait for the stop event to complete
    aclrtSynchronizeStream(stream);

    // Copy result to host memory and write to output file
    aclrtMemcpy(yHost, outputSize, yDevice, outputSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", yHost, outputSize);

    // Compare the result with the golden result（仅功能验证模式进行精度对比）
    bool goldenResult = true;
#if TEST_MODE == 1
    goldenResult = CompareResult(yHost, outputSize);
#endif

    // Clean up memory
    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

#if TEST_MODE == 1
    if (goldenResult) {
        printf("test pass!\n");
    } else {
        printf("test failed!\n");
    }
#endif
    return 0;
}
