/*!
 * \file bench_addrelu.asc
 * \brief Micro-benchmark: AddRelu Tensor vs pointer path, with/without per-iteration PipeBarrier.
 *        mode 0: Tensor + PipeBarrier   (legacy baseline)
 *        mode 1: pointer + PipeBarrier  (pointerized, samethesame as mode 0 cost)
 *        mode 2: pointer, no barrier    (optimized)
 *        mode 3: Tensor, no barrier
 */

#include <cstdio>
#include "acl/acl.h"
#include "kernel_operator.h"

template <uint32_t count, uint32_t iters, int mode>
__global__ __vector__ void bench_kernel(__gm__ half* src0Gm, __gm__ half* src1Gm, __gm__ half* dstGm,
    __gm__ uint64_t* cycleGm)
{
    AscendC::InitSocState();
    AscendC::GlobalTensor<half> src0Global;
    AscendC::GlobalTensor<half> src1Global;
    AscendC::GlobalTensor<half> dstGlobal;
    src0Global.SetGlobalBuffer(src0Gm);
    src1Global.SetGlobalBuffer(src1Gm);
    dstGlobal.SetGlobalBuffer(dstGm);

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<half> src0Local = ubAllocator.Alloc<half, count>();
    AscendC::LocalTensor<half> src1Local = ubAllocator.Alloc<half, count>();
    AscendC::LocalTensor<half> dstLocal = ubAllocator.Alloc<half, count>();

    AscendC::DataCopy(src0Local, src0Global, count);
    AscendC::DataCopy(src1Local, src1Global, count);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    int64_t start = AscendC::GetSystemCycle();
    for (uint32_t i = 0; i < iters; ++i) {
        if constexpr (mode == 0 || mode == 3) {
            AscendC::AddRelu<half>(dstLocal, src0Local, src1Local, count);
        } else {
            AscendC::AddRelu<half>(
                dstLocal.GetPhyAddr(), src0Local.GetPhyAddr(), src1Local.GetPhyAddr(), count);
        }
        if constexpr (mode == 0 || mode == 1) {
            AscendC::PipeBarrier<PIPE_V>();
        }
    }
    int64_t runCycle = AscendC::GetSystemCycle() - start;
    cycleGm[0] = static_cast<uint64_t>(runCycle);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::DataCopy(dstGlobal, dstLocal, count);
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t count = 512;
    constexpr uint32_t iters = 10000;
    const size_t bytes = count * sizeof(half);

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    half* src0Device = nullptr;
    half* src1Device = nullptr;
    half* dstDevice = nullptr;
    uint64_t* cycleDevice = nullptr;
    aclrtMalloc((void**)&src0Device, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&src1Device, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dstDevice, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&cycleDevice, 4 * sizeof(uint64_t), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemset(src0Device, bytes, 0, bytes);
    aclrtMemset(src1Device, bytes, 0, bytes);
    aclrtMemset(dstDevice, bytes, 0, bytes);

    bench_kernel<count, iters, 0><<<1, 0, stream>>>(src0Device, src1Device, dstDevice, cycleDevice + 0);
    aclrtSynchronizeStream(stream);
    bench_kernel<count, iters, 1><<<1, 0, stream>>>(src0Device, src1Device, dstDevice, cycleDevice + 1);
    aclrtSynchronizeStream(stream);
    bench_kernel<count, iters, 2><<<1, 0, stream>>>(src0Device, src1Device, dstDevice, cycleDevice + 2);
    aclrtSynchronizeStream(stream);
    bench_kernel<count, iters, 3><<<1, 0, stream>>>(src0Device, src1Device, dstDevice, cycleDevice + 3);
    aclrtSynchronizeStream(stream);

    uint64_t hostCycle[4] = {0, 0, 0, 0};
    aclrtMemcpy(hostCycle, sizeof(hostCycle), cycleDevice, sizeof(hostCycle), ACL_MEMCPY_DEVICE_TO_HOST);
    const char* names[4] = {"tensor+barrier", "ptr+barrier", "ptr_no_barrier", "tensor_no_barrier"};
    printf("BENCH count=%u iters=%u\n", count, iters);
    for (int m = 0; m < 4; ++m) {
        printf("%-18s cycles=%llu per_iter=%.4f\n", names[m], (unsigned long long)hostCycle[m],
            (double)hostCycle[m] / iters);
    }
    printf("speedup_ptr_no_barrier_over_ptr_barrier=%.4f\n",
        (double)hostCycle[1] / (double)hostCycle[2]);
    printf("speedup_ptr_no_barrier_over_tensor_barrier=%.4f\n",
        (double)hostCycle[0] / (double)hostCycle[2]);

    aclrtFree(src0Device);
    aclrtFree(src1Device);
    aclrtFree(dstDevice);
    aclrtFree(cycleDevice);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
