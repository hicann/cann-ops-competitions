/*!
 * \file bench_sweep.asc
 * \brief AddRelu per-element cycle sweep: Tensor vs pointer path, count = 512..16384, fixed 1000 iters.
 */

#include <cstdio>
#include "acl/acl.h"
#include "kernel_operator.h"

template <uint32_t count, bool usePtr>
__global__ __vector__ void sweep_kernel(__gm__ half* src0Gm, __gm__ half* src1Gm, __gm__ half* dstGm,
    __gm__ uint64_t* cycleGm, uint32_t iters)
{
    AscendC::InitSocState();
    AscendC::GlobalTensor<half> src0Global;
    AscendC::GlobalTensor<half> src1Global;
    AscendC::GlobalTensor<half> dstGlobal;
    src0Global.SetGlobalBuffer(src0Gm);
    src1Global.SetGlobalBuffer(src1Gm);
    dstGlobal.SetGlobalBuffer(dstGm);

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<half> src0Local = ubAllocator.Alloc<half, count>();
    AscendC::LocalTensor<half> src1Local = ubAllocator.Alloc<half, count>();
    AscendC::LocalTensor<half> dstLocal = ubAllocator.Alloc<half, count>();

    AscendC::DataCopy(src0Local, src0Global, count);
    AscendC::DataCopy(src1Local, src1Global, count);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    int64_t start = AscendC::GetSystemCycle();
    for (uint32_t i = 0; i < iters; ++i) {
        if constexpr (usePtr) {
            AscendC::AddRelu<half>(
                dstLocal.GetPhyAddr(), src0Local.GetPhyAddr(), src1Local.GetPhyAddr(), count);
        } else {
            AscendC::AddRelu<half>(dstLocal, src0Local, src1Local, count);
        }
    }
    int64_t runCycle = AscendC::GetSystemCycle() - start;
    cycleGm[0] = static_cast<uint64_t>(runCycle);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::DataCopy(dstGlobal, dstLocal, count);
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t iters = 1000;
    constexpr uint32_t maxCount = 16384;
    const size_t maxBytes = maxCount * sizeof(half);

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    half* src0Device = nullptr;
    half* src1Device = nullptr;
    half* dstDevice = nullptr;
    uint64_t* cycleDevice = nullptr;
    aclrtMalloc((void**)&src0Device, maxBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&src1Device, maxBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dstDevice, maxBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&cycleDevice, 2 * sizeof(uint64_t), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemset(src0Device, maxBytes, 0, maxBytes);
    aclrtMemset(src1Device, maxBytes, 0, maxBytes);
    aclrtMemset(dstDevice, maxBytes, 0, maxBytes);

    printf("BENCH sweep iters=%u\n", iters);
    printf("%-8s %-14s %-14s %-14s %-12s\n", "count", "tensor_cyc/el", "ptr_cyc/el", "ratio", "ptr_cyc/iter");
    uint64_t hostCycle[2] = {0, 0};

#define RUN_COUNT(C)                                                                                   \
    {                                                                                                  \
        sweep_kernel<C, false><<<1, 0, stream>>>(src0Device, src1Device, dstDevice, cycleDevice, iters); \
        aclrtSynchronizeStream(stream);                                                                \
        aclrtMemcpy(hostCycle, sizeof(hostCycle), cycleDevice, sizeof(hostCycle), ACL_MEMCPY_DEVICE_TO_HOST); \
        double tensorPerEl = (double)hostCycle[0] / iters / C;                                         \
        sweep_kernel<C, true><<<1, 0, stream>>>(src0Device, src1Device, dstDevice, cycleDevice, iters);  \
        aclrtSynchronizeStream(stream);                                                                \
        aclrtMemcpy(hostCycle, sizeof(hostCycle), cycleDevice, sizeof(hostCycle), ACL_MEMCPY_DEVICE_TO_HOST); \
        double ptrPerEl = (double)hostCycle[0] / iters / C;                                            \
        printf("%-8u %-14.6f %-14.6f %-14.4f %.2f\n", (unsigned)C, tensorPerEl, ptrPerEl,               \
            tensorPerEl / ptrPerEl, (double)hostCycle[0] / iters);                                     \
    }

    RUN_COUNT(512)
    RUN_COUNT(1024)
    RUN_COUNT(2048)
    RUN_COUNT(4096)
    RUN_COUNT(8192)
    RUN_COUNT(16384)
#undef RUN_COUNT

    aclrtFree(src0Device);
    aclrtFree(src1Device);
    aclrtFree(dstDevice);
    aclrtFree(cycleDevice);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
